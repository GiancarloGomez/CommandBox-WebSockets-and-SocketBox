{
    "name":"WebSocket.MultiSite.Demo",
    "trayEnable":true,
    "trayicon":"assets/img/favicon.png",
    "dockEnable":false,
    "debug":false,
    "console":true,
    "app":{
        "cfengine":"boxlang",
        "engineConfigFile":".boxlang.json"
    },
    "web":{
        "accessLogEnable":true,
        "aliases":{
            "/assets":"assets"
        },
        "bindings":{
            "HTTP":{
                "listen":8080
            }
        },
        "websocket":{
            "enable":true
        }
    },
    "sites":{
        "site1":{
            "hostAlias":"site1.local",
            "webroot":"site1/"
        },
        "site2":{
            "hostAlias":"site2.local",
            "webroot":"site2/",
            "websocket":{
                "enable":true,
                "listener":"services/WebSocket.cfc"
            }
        },
        "site3":{
            "hostAlias":"site3.local",
            "webroot":"site3/",
            "websocket":{
                "enable":true,
                "listener":"WebSocket.bx"
            }
        }
    },
    "scripts":{
        "onServerInitialInstall":"install bx-compat-cfml"
    }
}